{
  "name": "mythicplusmeta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "db:setup": "node server/apply-schema.js",
    "sync": "node server/sync.js && node server/sync-weekly.js",
