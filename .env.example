DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mythicplusmeta
DB_USER=root
DB_PASSWORD=

# Optional Raider.IO API key. Keep real keys in .env; never commit them.
RIO_API_KEY=

# History import uses a shared request pace and obeys Raider.IO rate-limit headers.
# Keep the 300ms default unless your registered Raider.IO app has a higher quota.
RIO_MIN_REQUEST_INTERVAL_MS=300
RIO_HISTORY_CONCURRENCY=5
RIO_HISTORY_REQUEST_DELAY_MS=0

# Optional Blizzard API credentials for weekly leaderboard imports.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
